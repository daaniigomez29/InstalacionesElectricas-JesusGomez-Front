---
import ServiceCTA from "../components/services/ServiceCTA.astro";
import ServiceFAQ from "../components/services/ServiceFAQ.astro";
import Layout from "../layouts/Layout.astro";
import AboutUs from "../sections/AboutUs.astro";
import Hero from "../sections/Hero.astro";
import LogoSliderSection from "../sections/LogoSliderSection.astro";
import GoogleReviews from "../sections/GoogleReviews.astro";
import FeaturedJobs from "../sections/FeaturedJobs.astro";
import Services from "../sections/Services.astro";
import Solution from "../sections/Solution.astro";
import { organizationSchema, websiteSchema } from "../lib/seo";
import { getHomeFaq, getHomeFinalCta, getHomeHero, getPageSeo } from "../lib/api";

// SEO desde Sanity (homePage.seo) con fallback hardcoded.
const seo = await getPageSeo("homePage");

// Hero precargado para LCP — preload de la imagen real (Sanity o fallback).
const heroData = await getHomeHero();
const heroImageUrl = heroData?.imageUrl ?? "/assets/backgrounds/jesus-hero.webp";

const title =
    seo?.title ??
    "Electricista en Sevilla | Instalaciones Eléctricas Jesús Gómez";
const description =
    seo?.description ??
    "Electricista en Sevilla para instalaciones eléctricas, reparaciones y mantenimiento. Atención rápida, servicio profesional y garantía.";
const canonical =
    seo?.canonical ?? "https://www.instalacioneselectricasjesusgomez.es/";
const ogImage =
    seo?.ogImageUrl ??
    "https://www.instalacioneselectricasjesusgomez.es/assets/logos/logo_jesus_completo.webp";
const ogImageAlt =
    "Instalaciones Eléctricas Jesús Gómez - Electricista en Sevilla";

// FAQ y CTA finales — Sanity con fallback hardcoded.
const homeFaq = await getHomeFaq();
const homeFinalCta = await getHomeFinalCta();

const fallbackHomeFaqs = [
    {
        question: "¿Quién es Instalaciones Eléctricas Jesús Gómez?",
        answer: "Somos una empresa de electricistas con sede en Sevilla, fundada por Jesús Gómez. Realizamos instalaciones, averías, reformas y mantenimiento eléctrico para viviendas, comunidades y negocios en Sevilla y toda Andalucía.",
    },
    {
        question: "¿Qué tipo de trabajos eléctricos realizáis?",
        answer: "Realizamos instalaciones eléctricas completas, reformas, reparación de averías, cambio de cuadros eléctricos, boletines y legalizaciones, iluminación LED, puntos de recarga para coche eléctrico y mantenimiento, tanto en viviendas como en locales y negocios.",
    },
    {
        question: "¿Sois instaladores eléctricos autorizados?",
        answer: "Sí. Estamos registrados como empresa instaladora autorizada, lo que nos habilita para emitir boletines eléctricos (CIE) y legalizar instalaciones ante la Junta de Andalucía.",
    },
    {
        question: "¿Trabajáis tanto para particulares como para empresas?",
        answer: "Sí. Atendemos a particulares, comunidades de propietarios y empresas. Adaptamos cada proyecto a las necesidades de viviendas, locales, oficinas y naves industriales.",
    },
    {
        question: "¿En qué zonas de Sevilla trabajáis?",
        answer: "Cubrimos Sevilla capital y los principales municipios del Aljarafe y el área metropolitana, como Dos Hermanas, Alcalá de Guadaíra o Mairena del Aljarafe. Si tu localidad no aparece en el listado, consúltanos: probablemente también te atendemos.",
    },
    {
        question: "¿Ofrecéis garantía en los trabajos?",
        answer: "Sí. Todos nuestros trabajos se entregan con factura y garantía por escrito. Usamos materiales homologados y cumplimos el Reglamento Electrotécnico de Baja Tensión (REBT).",
    },
    {
        question: "¿Cómo puedo pedir un presupuesto?",
        answer: "Puedes llamarnos al 691 88 63 70, escribirnos por WhatsApp o rellenar el formulario de la página de contacto. Te orientamos sin compromiso y te preparamos un presupuesto cerrado.",
    },
];

const homeFaqTitle = homeFaq?.title ?? "Preguntas frecuentes sobre nosotros";
const homeFaqs = homeFaq?.faq?.items?.length
    ? homeFaq.faq.items
    : fallbackHomeFaqs;

const homeCtaTitle = homeFinalCta?.title ?? "¿Hablamos de tu proyecto?";
const homeCtaText =
    homeFinalCta?.text ??
    "Cuéntanos qué necesitas y te asesoramos sin compromiso. Trabajo eléctrico profesional, autorizado y con garantía en Sevilla y Andalucía.";
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt={ogImageAlt}>
    <Fragment slot="head">
        <link
            rel="preload"
            as="image"
            href="/assets/backgrounds/fondo-circulo.webp"
            fetchpriority="high"
        />
        <link
            rel="preload"
            as="image"
            href={heroImageUrl}
            fetchpriority="high"
        />
    </Fragment>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(organizationSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteSchema)}
    />
    <main>
        <Hero />
        <AboutUs />
        <LogoSliderSection />
        <Solution />
        <Services />
        <FeaturedJobs />
        <GoogleReviews />
        <ServiceFAQ title={homeFaqTitle} faqs={homeFaqs} />
        <ServiceCTA title={homeCtaTitle} text={homeCtaText} />
    </main>
    <script>
        import { initFlowbite } from "flowbite";
        initFlowbite;
    </script>
</Layout>

<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("opacity-100", "translate-y-0");
                entry.target.classList.remove("opacity-0", "translate-y-10");
            }
        });
    });

    const observer2 = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("opacity-100", "translate-x-0");
                entry.target.classList.remove("opacity-0", "translate-x-20");
            }
        });
    });

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    document
        .querySelectorAll(".reveal-2")
        .forEach((el) => observer2.observe(el));
</script>
