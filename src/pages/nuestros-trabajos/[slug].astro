---
import Layout from "../../layouts/Layout.astro";
import WorkHero from "../../components/works/WorkHero.astro";
import ProjectStory from "../../components/works/ProjectStory.astro";
import ProjectGallery from "../../components/works/ProjectGallery.astro";
import ProjectInfo from "../../components/works/ProjectInfo.astro";
import ProjectTestimonial from "../../components/works/ProjectTestimonial.astro";
import CTASection from "../../components/works/CTASection.astro";
import { projects, type Project } from "../../data/projects";
import {
    absoluteUrl,
    buildArticle,
    buildBreadcrumb,
    buildImageObject,
} from "../../lib/seo";
import { getAllProjectsForBuild } from "../../lib/api";

/**
 * Genera una página por cada slug de proyecto.
 *
 * Estrategia idéntica a /servicios/[slug]: fusionamos los proyectos de
 * Sanity con los del fichero local `src/data/projects.ts`. Si un slug
 * existe en ambos lados, Sanity gana. Si solo existe local, se usa
 * local (fallback). Si solo existe en Sanity (proyecto añadido nuevo
 * en el CMS), se genera igualmente.
 */
export async function getStaticPaths() {
    const sanityProjects = await getAllProjectsForBuild();
    const sanityBySlug = new Map(sanityProjects.map((p) => [p.slug, p]));

    const merged: Project[] = projects.map(
        (local) => sanityBySlug.get(local.slug) ?? local,
    );
    const localSlugs = new Set(projects.map((p) => p.slug));
    for (const sanityP of sanityProjects) {
        if (!localSlugs.has(sanityP.slug)) {
            merged.push(sanityP);
        }
    }

    return merged.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

interface Props {
    project: Project;
}

const { project } = Astro.props;

const title = project.seo?.title ?? `${project.title} | Instalaciones Eléctricas Jesús Gómez`;
const description = project.seo?.description ?? project.summary;
const canonical = `https://www.instalacioneselectricasjesusgomez.es/nuestros-trabajos/${project.slug}`;

const breadcrumbSchema = buildBreadcrumb([
    { name: "Inicio", item: "/" },
    { name: "Nuestros trabajos", item: "/nuestros-trabajos" },
    { name: project.title, item: canonical },
]);

const articleImages = [
    absoluteUrl(project.coverImage.src),
    ...project.gallery.map((g) => absoluteUrl(g.src)),
];

const articleSchema = buildArticle({
    headline: project.title,
    description: project.summary,
    image: articleImages,
    url: canonical,
    articleBody: [project.problem, project.solution, project.result].join("\n\n"),
    aboutServiceName: project.type,
});

const imageObjectsSchema = project.gallery.map((g) => buildImageObject(g));
---

<Layout
    title={title}
    description={description}
    canonical={canonical}
    ogImage={absoluteUrl(project.coverImage.src)}
    ogImageAlt={project.coverImage.alt}
>
    <WorkHero
        title={project.title}
        subtitle={project.summary}
        bgImage={project.coverImage.src}
        tags={[project.type, project.location, project.duration]}
        breadcrumbs={[
            { label: "Inicio", href: "/" },
            { label: "Nuestros trabajos", href: "/nuestros-trabajos" },
            { label: project.title },
        ]}
    />

    <ProjectStory
        problem={project.problem}
        solution={project.solution}
        result={project.result}
    />

    <ProjectGallery images={project.gallery} />

    <ProjectInfo project={project} />

    {
        project.testimonial && (
            <ProjectTestimonial testimonial={project.testimonial} />
        )
    }

    <CTASection
        title="¿Necesitas un trabajo parecido?"
        text="Si tu instalación da problemas o quieres modernizarla, te ayudamos. Pide presupuesto sin compromiso para tu vivienda o negocio en Sevilla."
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(articleSchema)}
    />
    {
        imageObjectsSchema.map((img) => (
            <script
                type="application/ld+json"
                set:html={JSON.stringify(img)}
            />
        ))
    }
</Layout>
