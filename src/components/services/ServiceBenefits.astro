---
export interface Props {
    title: string;
    benefits: { title: string; description: string; icon?: string }[];
}

const { title, benefits } = Astro.props;
---

<section class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 background-fade">
    <div class="container mx-auto">
        <div class="flex justify-center mb-10">
            <h2 class="background-font-blue">{title}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                benefits.map((b) => (
                    <div class="bg-white rounded-xl shadow-md p-6 text-center hover:scale-105 transition reveal opacity-0 translate-y-10 duration-700">
                        <div class="text-4xl mb-3">{b.icon ?? "⚡"}</div>
                        <h3 class="font-bold text-primary-blue text-lg mb-2">
                            {b.title}
                        </h3>
                        <p class="text-gray-700">{b.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
