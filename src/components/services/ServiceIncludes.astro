---
export interface Props {
    title: string;
    intro?: string;
    items: { title: string; description: string }[];
}

const { title, intro, items } = Astro.props;
---

<section class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 bg-[#ffffffa5]">
    <div class="container mx-auto">
        <div class="flex justify-center mb-6">
            <h2 class="background-font-blue">{title}</h2>
        </div>
        {intro && <p class="text-center max-w-3xl mx-auto mb-10">{intro}</p>}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                items.map((item) => (
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-primary-orange hover:shadow-lg transition duration-300 reveal opacity-0 translate-y-10 duration-700">
                        <h3 class="font-bold text-primary-blue text-lg mb-2">
                            {item.title}
                        </h3>
                        <p class="text-gray-700">{item.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
