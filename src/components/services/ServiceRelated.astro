---
export interface Props {
    title?: string;
    related: { title: string; href: string; description: string }[];
}

const { title = "Servicios relacionados", related } = Astro.props;
---

<section class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 bg-[#F5F7FA]">
    <div class="container mx-auto">
        <div class="flex justify-center mb-10">
            <h2 class="background-font">{title}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
            {
                related.map((r) => (
                    <a
                        href={r.href}
                        class="bg-white rounded-xl shadow-md p-6 hover:ring-2 hover:ring-accent-blue/40 hover:-translate-y-1 transition duration-300 block"
                    >
                        <h3 class="font-bold text-primary-blue text-lg mb-2">
                            {r.title}
                        </h3>
                        <p class="text-gray-700 text-sm mb-3">{r.description}</p>
                        <span class="text-accent-blue font-semibold text-sm">
                            Ver servicio →
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</section>
