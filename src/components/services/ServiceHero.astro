---
import { sanityImg, sanitySrcSet } from "../../lib/sanityImage";

export interface Breadcrumb {
    label: string;
    href?: string;
}

export interface Props {
    h1: string;
    subtitle: string;
    bgImage?: string;
    breadcrumbs?: Breadcrumb[];
}

const {
    h1,
    subtitle,
    bgImage = "/assets/backgrounds/aboutus-bg-black.webp",
    breadcrumbs = [],
} = Astro.props;
---

<section class="relative isolate overflow-hidden scroll-m-25">
    <img
        src={sanityImg(bgImage, 1280)}
        srcset={sanitySrcSet(bgImage, [720, 1080, 1280, 1920])}
        sizes="100vw"
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover -z-20"
    />
    <div class="absolute inset-0 bg-black/65 -z-10" aria-hidden="true"></div>
    <div
        class="relative container mx-auto px-5 md:px-10 py-20 md:py-28 flex flex-col gap-6 text-white"
    >
    {
            breadcrumbs.length > 0 && (
                <nav aria-label="Migas de pan">
                    <ol class="flex flex-wrap items-center gap-2 text-sm text-white/80">
                        {breadcrumbs.map((crumb, index) => (
                            <li class="flex items-center gap-2">
                                {crumb.href ? (
                                    <a
                                        href={crumb.href}
                                        class="hover:text-primary-orange transition text-sm"
                                    >
                                        {crumb.label}
                                    </a>
                                ) : (
                                    <span
                                        aria-current="page"
                                        class="text-white text-sm"
                                    >
                                        {crumb.label}
                                    </span>
                                )}
                                {index < breadcrumbs.length - 1 && (
                                    <span aria-hidden="true">/</span>
                                )}
                            </li>
                        ))}
                    </ol>
                </nav>
            )
        }
        <h1 class="font-bold leading-tight max-w-4xl">
            {h1}
        </h1>
        <p class="max-w-2xl text-base md:text-lg">
            {subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-3">
            <a
                href="/contacto"
                class="btn-hero bg-accent-blue rounded p-3 lg:p-4 text-white font-semibold text-center"
            >
                Solicita tu presupuesto gratis
            </a>
            <a
                href="https://wa.me/691886370"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#25d366] hover:bg-[#1eb955] transition rounded p-3 lg:p-4 text-white font-semibold text-center"
            >
                Escríbenos por WhatsApp
            </a>
            <a
                href="tel:+34691886370"
                class="bg-primary-orange hover:bg-orange-600 transition rounded p-3 lg:p-4 text-white font-semibold text-center"
            >
                Llamar: 691 88 63 70
            </a>
        </div>
    </div>
</section>

<style>
    .btn-hero {
        background-image: linear-gradient(135deg, #1e3eb1 50%, transparent 50%);
        background-position: bottom right;
        background-size: 200% 200%;
        transition: 0.4s;
    }
    .btn-hero:hover {
        background-position: top left;
        color: white;
    }
</style>
