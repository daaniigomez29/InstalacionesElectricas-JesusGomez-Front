---
/** Llamada a la acción final reutilizable. */
export interface Props {
    title?: string;
    text?: string;
}

const {
    title = "¿Tienes un proyecto eléctrico en mente?",
    text = "Cuéntanos qué necesitas y te preparamos un presupuesto sin compromiso. Trabajamos en Sevilla y alrededores.",
} = Astro.props;
---

<section
    class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 bg-primary-blue text-white"
>
    <div
        class="container mx-auto flex flex-col items-center text-center gap-5 max-w-3xl"
    >
        <h2 class="font-bold text-2xl md:text-3xl">{title}</h2>
        <p class="text-base md:text-lg">{text}</p>
        <div class="flex flex-col sm:flex-row gap-4 pt-3 w-full sm:w-auto">
            <a
                href="/contacto"
                class="bg-primary-orange hover:bg-orange-600 transition rounded p-3 lg:p-4 text-white font-semibold"
            >
                Pedir presupuesto
            </a>
            <a
                href="https://wa.me/691886370"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#25d366] hover:bg-[#1eb955] transition rounded p-3 lg:p-4 text-white font-semibold"
            >
                WhatsApp directo
            </a>
            <a
                href="tel:+34691886370"
                class="bg-accent-blue hover:bg-blue-700 transition rounded p-3 lg:p-4 text-white font-semibold"
            >
                Llamar ahora
            </a>
        </div>
    </div>
</section>
