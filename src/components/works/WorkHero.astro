---
/**
 * Hero reutilizable para la sección de trabajos.
 * - Página principal: úsalo con `size="sm"` (hero pequeño).
 * - Página de proyecto: añade `tags` y `breadcrumbs`.
 */
export interface Breadcrumb {
    label: string;
    href?: string;
}

export interface Props {
    title: string;
    subtitle?: string;
    bgImage?: string;
    tags?: string[];
    breadcrumbs?: Breadcrumb[];
    size?: "sm" | "lg";
}

const {
    title,
    subtitle,
    bgImage = "/assets/backgrounds/aboutus-bg-black.webp",
    tags = [],
    breadcrumbs = [],
    size = "lg",
} = Astro.props;

const verticalPadding = size === "sm" ? "py-16 md:py-20" : "py-20 md:py-28";
---

<section
    class="relative overflow-hidden scroll-m-25 bg-primary-blue"
    style={`background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.6)), url(${bgImage}); background-size: cover; background-position: center;`}
>
    <div
        class:list={[
            "container mx-auto px-5 md:px-10 flex flex-col gap-5 text-white",
            verticalPadding,
        ]}
    >
        {
            breadcrumbs.length > 0 && (
                <nav aria-label="Migas de pan">
                    <ol class="flex flex-wrap items-center gap-2 text-sm text-white/80">
                        {breadcrumbs.map((crumb, index) => (
                            <li class="flex items-center gap-2">
                                {crumb.href ? (
                                    <a
                                        href={crumb.href}
                                        class="hover:text-primary-orange transition text-sm"
                                    >
                                        {crumb.label}
                                    </a>
                                ) : (
                                    <span
                                        aria-current="page"
                                        class="text-white text-sm"
                                    >
                                        {crumb.label}
                                    </span>
                                )}
                                {index < breadcrumbs.length - 1 && (
                                    <span aria-hidden="true">/</span>
                                )}
                            </li>
                        ))}
                    </ol>
                </nav>
            )
        }

        {
            tags.length > 0 && (
                <ul class="flex flex-wrap gap-2">
                    {tags.map((tag) => (
                        <li class="bg-primary-orange text-white text-xs md:text-sm font-semibold px-3 py-1 rounded-full">
                            {tag}
                        </li>
                    ))}
                </ul>
            )
        }

        <h1 class="font-bold leading-tight max-w-4xl">{title}</h1>

        {
            subtitle && (
                <p class="max-w-2xl text-base md:text-lg text-white/90">
                    {subtitle}
                </p>
            )
        }
    </div>
</section>
