---
/** Ficha técnica del proyecto (ubicación, tipo, duración, cliente). */
import type { Project } from "../../data/projects";
import SectionTitle from "./SectionTitle.astro";

export interface Props {
    project: Project;
    title?: string;
}

const { project, title = "Ficha técnica del proyecto" } = Astro.props;

const facts = [
    { icon: "📍", label: "Ubicación", value: project.location },
    { icon: "🔧", label: "Tipo de trabajo", value: project.type },
    { icon: "⏱️", label: "Duración", value: project.duration },
    { icon: "👤", label: "Cliente", value: project.client },
];
---

<section class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 bg-[#ffffffa5]">
    <div class="container mx-auto flex flex-col gap-10">
        <SectionTitle title={title} />

        <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 max-w-5xl mx-auto w-full">
            {
                facts.map((fact) => (
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-primary-orange flex flex-col gap-1 reveal opacity-0 translate-y-10 duration-700">
                        <span class="text-2xl" aria-hidden="true">
                            {fact.icon}
                        </span>
                        <dt class="text-gray-500 text-sm font-semibold uppercase tracking-wide">
                            {fact.label}
                        </dt>
                        <dd class="text-primary-blue font-bold text-lg">
                            {fact.value}
                        </dd>
                    </div>
                ))
            }
        </dl>
    </div>
</section>
