---
/** Testimonio opcional del cliente del proyecto. */
import type { Testimonial } from "../../data/projects";

export interface Props {
    testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<section class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 background-fade">
    <div class="container mx-auto max-w-3xl">
        <figure
            class="bg-white rounded-2xl shadow-md p-8 md:p-12 flex flex-col items-center text-center gap-5 reveal opacity-0 translate-y-10 duration-700"
        >
            <span
                class="text-primary-orange text-6xl leading-none"
                aria-hidden="true"
            >
                &ldquo;
            </span>
            <blockquote
                class="text-lg md:text-xl text-gray-700 font-medium leading-relaxed"
            >
                {testimonial.quote}
            </blockquote>
            {
                testimonial.author && (
                    <figcaption class="text-primary-blue font-bold">
                        {testimonial.author}
                    </figcaption>
                )
            }
        </figure>
    </div>
</section>
