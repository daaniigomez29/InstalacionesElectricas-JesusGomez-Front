---
import type { Project } from "../data/projects";
import LocationIcon from "../icons/LocationIcon.astro";
import ClockIcon from "../icons/ClockIcon.astro";

export interface Props {
    project: Project;
}

const { project } = Astro.props;
const href = `/nuestros-trabajos/${project.slug}`;
---

<article class="embla__slide">
    <div
        class="flex flex-col md:flex-row items-stretch w-full gap-6 md:gap-8 lg:gap-12 md:justify-center"
    >
        <a
            href={href}
            class="relative w-full md:w-1/2 lg:w-5/12 block group overflow-hidden rounded-lg shadow-lg"
            aria-label={`Ver proyecto: ${project.title}`}
        >
            <img
                src={project.coverImage.src}
                alt={project.coverImage.alt}
                loading="lazy"
                class="w-full h-72 md:h-96 object-cover group-hover:scale-105 transition duration-500"
            />
            <span
                class="absolute top-3 left-3 bg-primary-orange text-white text-xs font-semibold px-3 py-1 rounded-full shadow"
            >
                {project.type}
            </span>
        </a>

        <div
            class="flex flex-col justify-center gap-4 w-full md:w-1/2 lg:w-5/12 md:py-4 text-white"
        >
            <div
                class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-white"
            >
                <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 backdrop-blur-sm px-3 py-1.5 rounded-full whitespace-nowrap">
                    <LocationIcon class="w-4 h-4 shrink-0" fillBorder="orange" />
                    {project.location}
                </span>
                <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 backdrop-blur-sm px-3 py-1.5 rounded-full whitespace-nowrap">
                    <ClockIcon class="w-4 h-4 shrink-0 text-primary-orange" />
                    {project.duration}
                </span>
            </div>

            <h3 class="font-bold text-xl md:text-2xl lg:text-3xl leading-snug">
                <a
                    href={href}
                    class="hover:text-primary-orange transition"
                >
                    {project.title}
                </a>
            </h3>

            <p class="text-white/90 text-sm md:text-base">
                {project.summary}
            </p>

            <div class="pt-1">
                <a
                    href={href}
                    class="group/cta inline-flex items-center gap-2 text-white font-semibold hover:text-primary-orange transition border-b-2 border-white/40 hover:border-primary-orange pb-1"
                >
                    Ver proyecto
                    <span
                        aria-hidden="true"
                        class="transition-transform group-hover/cta:translate-x-1"
                    >
                        →
                    </span>
                </a>
            </div>
        </div>
    </div>
</article>

<style>
    .embla__slide {
        display: flex;
        transform: translate3d(0, 0, 0);
        flex: 0 0 var(--slide-size);
        min-width: 0;
        padding-left: var(--slide-spacing);
    }
</style>
