---
import { getHomeHero } from "../lib/api";

const hero = await getHomeHero();

// Fallback: si Sanity no tiene rellenada la sección o algún campo,
// usamos los textos / imagen / CTAs originales hardcodeados.
const pretitle =
    hero?.pretitle ?? "Electricista técnico autorizado en Sevilla";
const titleLine1 = hero?.titleLine1 ?? "Soluciones eléctricas profesionales en";
const titleLine2 = hero?.titleLine2 ?? "Sevilla y Andalucía";
const description =
    hero?.description ??
    "Reparaciones, instalaciones y mantenimiento eléctrico con garantía. Atención rápida y servicio profesional para tu hogar o negocio.";
const heroImage = hero?.imageUrl ?? "/assets/backgrounds/jesus-hero.webp";
const heroImageAlt =
    hero?.imageAlt ??
    "CEO de Instalaciones eléctricas Jesús Gómez, encargado de todas las operaciones.";
const ctaPrimaryLabel = hero?.ctaPrimary?.label ?? "Solicita tu presupuesto";
const ctaPrimaryHref = hero?.ctaPrimary?.href ?? "/contacto";
const ctaSecondaryLabel =
    hero?.ctaSecondary?.label ?? "O llama ahora al 691 88 63 70";
const ctaSecondaryHref = hero?.ctaSecondary?.href ?? "tel:+34691886370";
---

<section
  id="inicio"
  class="px-5 pt-10 lg:px-10 lg:pt-0 lg:min-h-[calc(100dvh-134px)] bg-[#F5F7FA] scroll-m-35 overflow-hidden flex items-center"
>
  <div
    class="lg:grid lg:grid-cols-2 flex flex-col items-center justify-center w-full container mx-auto gap-y-10 md:gap-y-20"
  >
    <div class="flex flex-col">
      <div class="">
        <p
          class="text-primary-orange text-[11px]! font-bold tracking-widest uppercase mb-2"
        >
          {pretitle}
        </p>
      </div>
      <h1 class="font-bold">
        {titleLine1}
        <span class="background-font text-start!">{titleLine2}</span>
      </h1>
      <p class="pt-5">{description}</p>
      <div class="pt-7">
        <a
          href={ctaPrimaryHref}
          class="btn-hero bg-accent-blue rounded p-3 lg:p-4 text-white font-semibold text-lg group/cta inline-flex gap-2"
          >{ctaPrimaryLabel} <span
                        aria-hidden="true"
                        class="transition-transform group-hover/cta:translate-x-1"
                    >
                        →
                    </span></a
        >
      </div>
      <div class="pt-10">
        <a
          href={ctaSecondaryHref}
          class="text-accent-blue font-semibold text-lg hover:text-primary-orange transition duration-300"
          >{ctaSecondaryLabel} <span class="underline">691 88 63 70</span></a
        >
      </div>
    </div>
    <div
      class="relative flex items-end justify-center w-full md:h-[clamp(420px,75vh,1220px)] img-div"
    >
      <!-- CÍRCULO -->
      <div class="circle-bg"></div>

      <!-- IMAGEN -->
      <img
        src={heroImage}
        loading="eager"
        fetchpriority="high"
        class="img-size relative z-10 object-contain h-full w-auto img-animation"
        alt={heroImageAlt}
      />
    </div>
  </div>
</section>

<style>
  @media (min-width: 1300px) {
    .img-div {
      height: clamp(460px, calc(100dvh - 134px), 940px);
    }
  }

  .circle-bg {
    position: absolute;

    /* TAMAÑO RESPONSIVE REAL */
    width: clamp(510px, 120vmin, 1550px);
    height: clamp(510px, 120vmin, 1550px);

    border-radius: 50%;
    background-color: #f39615;
    background-image: url("/assets/backgrounds/fondo-circulo.webp");
    background-repeat: repeat;
    filter: brightness(1);

    /* POSICIÓN RESPONSIVE */
    /* right: clamp(-580px, -39vmin, -170px); */
    bottom: clamp(-420px, -35vmin, -160px);

    /* SOMBRA FIGMA */
    box-shadow: 0px 69px 19.9px rgba(0, 0, 0, 0.25);

    z-index: 0;

    /* ANIMACIÓN DIAGONAL INFINITA */
    animation:
      patternMove 50s linear infinite,
      imgDivEnterPc 1s ease-out forwards;

    /* EVITA BUGS EN LANDSCAPE */
  }

  .img-animation {
    animation: imgDivEnterPc2 0.8s ease-out both;
  }

  @media (min-width: 1280px) {
    .circle-bg {
      width: clamp(900px, 63vw, 1225px);
      height: clamp(900px, 75vw, 1450px);

      right: clamp(-450px, -25vw, -250px);
    }
  }

  @media (max-width: 1300px) {
    .img-animation {
      animation: imgDivEnterMobile 0.8s ease-out both;
    }
    .circle-bg {
      animation:
        imgDivEnterMobile 0.8s ease-out both,
        patternMove 50s linear infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .img-animation,
    .circle-bg {
      animation: none !important;
    }
  }

  @keyframes patternMove {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 400px -600px;
    }
  }

  @keyframes imgDivEnterMobile {
    0% {
      transform: translateY(40px);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes imgDivEnterPc {
    0% {
      transform: translateX(120px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes imgDivEnterPc2 {
    0% {
      transform: translateX(120px);
    }
    100% {
      transform: translateX(0);
    }
  }

  /*
h1 {
		font-size: 1.875rem;
}
*/

  @media (min-width: 1440px) {
    h1 {
      font-size: 2.875rem;
    } /* 46px */
  }
</style>
