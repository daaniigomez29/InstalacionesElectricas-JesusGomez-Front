---
import { getServicesFeaturedCases } from "../../lib/api";

const featuredFromSanity = await getServicesFeaturedCases();

const cases = [
    {
        img: "/assets/ourJobs/trabajo-luz.webp",
        title: "Renovación eléctrica de local comercial en Sevilla",
        description:
            "Sustitución completa del cuadro, nueva derivación individual y reorganización de circuitos para adaptar el local a la actividad. Entrega con boletín CIE y puesta en servicio.",
    },
    {
        img: "/assets/worksSection/iluminacion.webp",
        title: "Iluminación LED en comunidad de vecinos",
        description:
            "Cambio completo de luminarias en escaleras y portales con detectores de presencia. Reducción del consumo en zonas comunes y mejora del cumplimiento normativo.",
    },
    {
        img: "/assets/worksSection/instalaciones-electricas.webp",
        title: "Punto de recarga en plaza de garaje",
        description:
            "Instalación de wallbox 7,4 kW con protecciones específicas y subcontador. Tramitación del boletín y coordinación con la comunidad para la canalización.",
    },
];

const casesToShow = featuredFromSanity?.cases?.length
    ? featuredFromSanity.cases
    : cases;
---

<section class="p-5 md:p-10 py-15 md:py-20 scroll-m-25 bg-[#F5F7FA]">
    <div class="container mx-auto">
        <div class="flex justify-center mb-4">
            <h2 class="background-font">
                {featuredFromSanity?.title ?? "Proyectos destacados"}
            </h2>
        </div>
        <p class="text-center max-w-2xl mx-auto mb-10 text-gray-700">
            Una muestra de algunos trabajos recientes que reflejan el tipo
            de intervenciones que hacemos cada semana.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {
                casesToShow.map((c) => (
                    <article class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col hover:-translate-y-1 transition duration-300">
                        <div class="h-48 overflow-hidden">
                            <img
                                src={c.img}
                                alt={c.title}
                                loading="lazy"
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div class="p-5 flex flex-col gap-2 flex-1">
                            <h3 class="font-bold text-primary-blue text-lg">
                                {c.title}
                            </h3>
                            <p class="text-gray-700 text-sm">
                                {c.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
