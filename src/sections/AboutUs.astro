---
import LocationIcon from "../icons/LocationIcon.astro";
import ToolsIcon from "../icons/ToolsIcon.astro";
import ToolsIcon2 from "../icons/ToolsIcon2.astro";
import QualityIcon from "../icons/QualityIcon.astro";
import HeartIcon from "../icons/HeartIcon.astro";
import BoltIcon from "../icons/BoltIcon.astro";
import CheckIcon from "../icons/CheckIcon.astro";
import CustomerServiceIcon from "../icons/CustomerServiceIcon.astro";
---

<section
    id="sobre-nosotros"
    class="bg-[url(/assets/backgrounds/aboutus-bg-black.webp)] bg-no-repeat bg-cover scroll-m-25 md:scroll-m-25 overflow-hidden mask-fade"
>
    <div
        class="container mx-auto flex flex-col justify-center p-5 md:p-10 py-15 md:py-25 gap-10 text-white"
    >
        <div class="flex justify-center">
            <h2 class="background-font">Tu energía, en buenas manos</h2>
        </div>

        <div
            class="flex flex-col md:flex-row items-center gap-8 md:gap-15 pb-5"
        >
            <div class="flex flex-col gap-10 md:flex-1">
                <p class="font-semibold">
                    Especialistas en obras eléctricas completas en viviendas,
                    locales y negocios
                </p>
                <p>
                    En <b>Instalaciones Eléctricas Jesús Gómez</b> somos electricistas profesionales especializados en obras eléctricas integrales, tanto en reformas como en proyectos nuevos. Realizamos la instalación eléctrica completa de viviendas, locales comerciales, oficinas, naves y comunidades, cuidando cada detalle para garantizar seguridad, eficiencia y cumplimiento normativo.
</p>

<div
            class="flex flex-col items-start gap-10 font-semibold"
        >
            <div
                class="flex gap-2 items-center reveal opacity-0 translate-y-10 duration-1000"
            >
                <LocationIcon />
                <p>Presencia en toda Andalucía, operando desde Sevilla.</p>
            </div>
            <div
                class="flex gap-2 items-center reveal opacity-0 translate-y-10 duration-1000 delay-200"
            > 
                <QualityIcon />
                <p>
                    Nos comprometemos con los más altos estándares de calidad y
                    seguridad, cumpliendo con todas las normativas vigentes.
                </p>
            </div>
            <div
                class="flex gap-2 items-center reveal opacity-0 translate-y-10 duration-1000 delay-300"
            >
                <ToolsIcon2 />
                <p>
                    Utilizamos las últimas tecnologías y herramientas para
                    garantizar instalaciones seguras, eficientes y duraderas.
                </p>
            </div>
            <div
                class="flex gap-2 items-center reveal opacity-0 translate-y-10 duration-1000 delay-400"
            >
                <ToolsIcon />
                <p>
                    Ofrecemos soluciones a medida, adaptadas a las necesidades
                    específicas de cada proyecto industrial.
                </p>
            </div>
        </div>
            </div>
            <div class="w-full md:flex-1 flex justify-center">
                <img
                    src="/assets/team/furgoneta.webp"
                    alt="Furgoneta de Instalaciones Eléctricas Jesús Gómez, electricistas en Sevilla"
                    width="3840"
                    height="5120"
                    loading="lazy"
                    class="w-full max-w-[330px] md:max-w-[360px] h-auto rounded-2xl border border-[#D4AF37]/20 shadow-lg object-cover reveal opacity-0 translate-y-10 duration-1000"
                />
            </div>
        </div>
