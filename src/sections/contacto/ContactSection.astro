---
import PhoneIcon from "../../icons/PhoneIcon.astro";
import MailIcon from "../../icons/MailIcon.astro";
import TimeIcon from "../../icons/TimeIcon.astro";
import WhatsappIcon from "../../icons/WhatsappIcon.astro";
import ClockIcon from "../../icons/ClockIcon.astro";
import LocationIcon from "../../icons/LocationIcon.astro";
---

<section id="contacto" class="bg-[#dce8f9c9] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="text-center mb-12">
            <p
                class="text-primary-orange text-xs! font-semibold tracking-widest uppercase mb-3"
            >
                Contacto
            </p><h1
                class="text-3xl! md:text-4xl! xl:text-5xl! font-bold leading-tight mb-3"
            >
                Solicita tu <span class="text-primary-orange">presupuesto</span>
            </h1><p class="text-dark-grey text-base">
                Sin compromiso · Respuesta en 24 horas
            </p>
        </div><div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-12">
            <div class="lg:col-span-3">
                <form
                    data-readdy-form="true"
                    id="presupuesto-form"
                    action="https://formspree.io/f/mzzndrrj"
                    method="post"
                    class="bg-[#1E1E1E] rounded-2xl p-6 md:p-8 space-y-5"
                >
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label
                                class="block text-[#C5C5C5] text-sm font-medium mb-2"
                                >Nombre</label
                            ><input
                                placeholder="Tu nombre"
                                class="w-full bg-[#141414] border border-[#333] focus:border-primary-orange text-white text-sm px-4 py-3 rounded-lg outline-none transition-colors placeholder-[#555]"
                                type="text"
                                name="nombre"
                            />
                        </div><div>
                            <label
                                class="block text-[#C5C5C5] text-sm font-medium mb-2"
                                >Email *</label
                            ><input
                                required=""
                                placeholder="tu@email.com"
                                class="w-full bg-[#141414] border border-[#333] focus:border-primary-orange text-white text-sm px-4 py-3 rounded-lg outline-none transition-colors placeholder-[#555]"
                                type="email"
                                name="email"
                            />
                        </div>
                    </div><div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label
                                class="block text-[#C5C5C5] text-sm font-medium mb-2"
                                >Teléfono *</label
                            ><input
                                required=""
                                placeholder="612345678"
                                class="w-full bg-[#141414] border border-[#333] focus:border-primary-orange text-white text-sm px-4 py-3 rounded-lg outline-none transition-colors placeholder-[#555]"
                                type="tel"
                                name="telefono"
                                inputmode="numeric"
                                maxlength="9"
                                pattern="[0-9]{9}"

                            />
                        </div>
                    </div><div>
                        <label
                            class="block text-[#C5C5C5] text-sm font-medium mb-2"
                            >Mensaje *</label
                        ><textarea
                            name="mensaje"
                            rows="4"
                            maxlength="500"
                            placeholder="Cuéntanos más sobre tu consulta..."
                            class="w-full bg-[#141414] border border-[#333] focus:border-primary-orange text-white text-sm px-4 py-3 rounded-lg outline-none transition-colors placeholder-[#555] resize-none"
                        ></textarea>
                    </div><div class="flex items-start gap-3">
                        <input
                            required=""
                            id="privacidad"
                            class="mt-1 accent-primary-orange cursor-pointer"
                            type="checkbox"
                            name="privacidad"
                        /><label
                            for="privacidad"
                            class="text-[#888] text-xs leading-relaxed cursor-pointer"
                            >He leído y acepto la <a
                                href="/politica-privacidad"
                                class="text-[#D4AF37] underline hover:text-[#B8960F]"
                                >Política de Privacidad</a
                            > y el <a
                                href="/aviso-legal"
                                class="text-[#D4AF37] underline hover:text-[#B8960F]"
                                >Aviso Legal</a
                            ></label
                        >
                    </div><button
                        type="submit"
                        class="w-full flex items-center justify-center gap-2 bg-primary-orange text-white font-bold text-sm py-4 rounded-full hover:scale-[1.02] hover:shadow-xl hover:shadow-[#D4AF37]/30 transition-all duration-200 cursor-pointer whitespace-nowrap disabled:opacity-60"
                        ><i class="ri-send-plane-fill"></i> ENVIAR CONSULTA</button
                    >
                </form>
            </div><div class="lg:col-span-2 flex flex-col gap-6">
                <div
                    class="bg-[#1E1E1E] rounded-2xl p-6 border-l-4 border-primary-orange space-y-5"
                >
                    <div class="flex items-center gap-4">
                        <span
                            class="w-8 h-8 flex items-center justify-center text-[#D4AF37] shrink-0 mt-0.5"
                            ><LocationIcon />
                        </span><div>
                            <p
                                class="text-[#888] text-xs uppercase tracking-wide mb-1"
                            >
                                Dirección
                            </p><p class="text-white text-sm">
                                C. Tungsteno, Norte, 41007 Sevilla
                            </p><p class="text-[#B0B0B0] text-xs">
                                Atendemos toda la provincia
                            </p>
                        </div>
                    </div><div class="h-px bg-[#D4AF37]/20"></div><div
                        class="flex items-center gap-4"
                    >
                        <span
                            class="w-8 h-8 flex items-center justify-center text-[#D4AF37] shrink-0"
                            ><PhoneIcon fill="#D4AF37" /></span
                        ><div>
                            <p
                                class="text-[#888] text-xs uppercase tracking-wide mb-1"
                            >
                                Teléfono
                            </p><a
                                href="tel:+34691886370"
                                class="text-white font-bold text-lg hover:text-primary-orange transition-colors cursor-pointer underline"
                                >691 88 63 70</a
                            >
                        </div>
                    </div><div class="h-px bg-[#D4AF37]/20"></div><div
                        class="flex items-center gap-4"
                    >
                        <span
                            class="w-8 h-8 flex items-center justify-center text-[#D4AF37] shrink-0 mt-0.5"
                            ><MailIcon fill="#D4AF37" />
                        </span><div>
                            <p
                                class="text-[#888] text-xs uppercase tracking-wide mb-1"
                            >
                                Email
                            </p><a
                                href="jesusgomezgranado@gmail.com"
                                class="text-white text-sm hover:text-primary-orange transition-colors cursor-pointer underline"
                                >jesusgomezgranado@gmail.com</a
                            >
                        </div>
                    </div><div class="h-px bg-[#D4AF37]/20"></div><div
                        class="flex items-center gap-4"
                    >
                        <span
                            class="w-8 h-8 flex items-center justify-center text-[#D4AF37] shrink-0"
                            ><ClockIcon /></span
                        ><div>
                            <p
                                class="text-[#888] text-xs uppercase tracking-wide mb-1"
                            >
                                Horario
                            </p><p class="text-white text-sm">
                                Lun – Sáb: 7:00 – 22:00
                            </p>
                        </div>
                    </div>
                </div><a
                    href="https://wa.me/34691886370"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-3 bg-[#25D366] text-white font-semibold text-sm py-4 rounded-full hover:scale-105 transition-all duration-200 cursor-pointer whitespace-nowrap"
                    ><span class="w-5 h-5 flex items-center justify-center">
                        <WhatsappIcon fill="white" />
                    </span>Chatea con nosotros por WhatsApp</a
                ><div class="rounded-2xl overflow-hidden h-56">
                    <iframe
                        title="Ubicación Instalaciones Eléctricas Jesús Gómez Sevilla"
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2240.9711035321952!2d-5.95510237951317!3d37.408470166092044!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd1269a7836ca7af%3A0x9ec664c53e9c8f19!2sInstalaciones%20El%C3%A9ctricas%20Jes%C3%BAs%20G%C3%B3mez%20%2F%20Electricista%20autorizado%20en%20Sevilla!5e0!3m2!1ses!2ses!4v1779968465618!5m2!1ses!2ses"
                        width="100%"
                        height="100%"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        style="border: 0px; filter: grayscale(30%) contrast(1.1);"
                    ></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
